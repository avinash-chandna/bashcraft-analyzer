{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/analyze.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/health.js": {
      "maxDuration": 30
    },
    "api/meta.js": {
      "maxDuration": 30
    }
  }
}
